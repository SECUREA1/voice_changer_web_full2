  <script>
    // Scene setup
    const width = window.innerWidth, height = window.innerHeight * 0.7;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, width/height, 0.1, 100);
    camera.position.set(0, 1, 4);

    const renderer = new THREE.WebGLRenderer({antialias:true,alpha:true});
    renderer.setClearColor(0x18192d);
    renderer.setSize(width, height);
    document.getElementById('canvas-container').appendChild(renderer.domElement);

    // Lights
    const ambient = new THREE.AmbientLight(0xffffff, 0.85);
    scene.add(ambient);
    const dir = new THREE.DirectionalLight(0xffffff, 0.6);
    dir.position.set(2,4,4);
    scene.add(dir);

    // Floor
    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(8,8),
      new THREE.MeshStandardMaterial({color:0x111111, roughness:0.9, metalness:0.1})
    );
    floor.rotation.x = -Math.PI/2;
    floor.position.y = -0.41;
    scene.add(floor);

    // Models
    let nftModel, coinModel;
    let coinCollected = false;

    // GLB Loader
    const gltfLoader = new THREE.GLTFLoader();

    // Astronaut Model (NFT)
    gltfLoader.load(
      'https://modelviewer.dev/shared-assets/models/Astronaut.glb',
      function(gltf) {
        nftModel = gltf.scene;
        nftModel.scale.set(0.8,0.8,0.8);
        nftModel.position.set(-1,0,0);
        nftModel.userData.draggable = true;
        scene.add(nftModel);
        readyToDrag();
      }
    );

    // Coin Model (simple yellow torus if no GLB)
    function createCoinMesh() {
      const coin = new THREE.Mesh(
        new THREE.TorusGeometry(0.22, 0.09, 18, 48),
        new THREE.MeshStandardMaterial({ color: 0xffd700, metalness: 0.82, roughness: 0.29 })
      );
      coin.position.set(1.3,0,0.1);
      coin.rotation.x = Math.PI/2;
      coin.castShadow = coin.receiveShadow = true;
      coin.userData.draggable = false;
      return coin;
    }
    coinModel = createCoinMesh();
    scene.add(coinModel);

    // Rewards logic
    let coinCount = 0;
    function collectCoin() {
      if (!coinCollected) {
        coinCollected = true;
        scene.remove(coinModel);
        coinCount++;
        document.getElementById('rewards-bar-coin').textContent = coinCount;
        // Animate reward bar (optional)
        document.getElementById('rewards-bar').style.background = "#38d57c";
        setTimeout(()=>document.getElementById('rewards-bar').style.background = "#232313", 600);
      }
    }

    // Drag Controls
    function readyToDrag() {
      const dragObjects = [nftModel];
      const controls = new THREE.DragControls(dragObjects, camera, renderer.domElement);

      controls.addEventListener('dragstart', function (event) {
        event.object.material && (event.object.material.emissive = { r:0.5, g:0.5, b:0.5 });
      });
      controls.addEventListener('dragend', function (event) {
        event.object.material && (event.object.material.emissive = { r:0, g:0, b:0 });
      });
    }

    // Collision check
    function checkCollision() {
      if (nftModel && coinModel && !coinCollected) {
        // Bounding boxes
        const nftBox = new THREE.Box3().setFromObject(nftModel);
        const coinBox = new THREE.Box3().setFromObject(coinModel);
        return nftBox.intersectsBox(coinBox);
      }
      return false;
    }

    // Animate
    function animate() {
      requestAnimationFrame(animate);
      if (coinModel && !coinCollected) coinModel.rotation.y += 0.035;
      if (checkCollision()) collectCoin();
      renderer.render(scene, camera);
    }
    animate();

    // Responsive
    window.addEventListener('resize', ()=>{
      const w = window.innerWidth, h = window.innerHeight * 0.7;
      renderer.setSize(w,h);
      camera.aspect = w/h;
      camera.updateProjectionMatrix();
    });
