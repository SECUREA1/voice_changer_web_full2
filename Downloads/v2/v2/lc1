    ];
    coins.forEach(c => {
      const m = new THREE.Mesh(
        new THREE.TorusGeometry(0.13, 0.055, 19, 44),
        new THREE.MeshStandardMaterial({ color: c.color, metalness: 0.71, roughness: 0.27 })
