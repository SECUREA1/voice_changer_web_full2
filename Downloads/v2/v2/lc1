  <script>
    // --- Rewards State ---
    const REWARDS = [
      {id:'alien', emoji:'👽', label:"Alien", count:3, color:0x85f6a1},
      {id:'moonrock', emoji:'🪨', label:"Moon", count:12, color:0xd4d6d8}
    ];
    let rewardsBarMesh, coinMeshes = [];

    // --- Scene ---
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera();
    let renderer;
    let controller;
    let xrSessionActive = false;

    // --- NFT GLB Model Loader ---
    function loadGLB(url, onLoad) {
      const loader = new THREE.GLTFLoader();
      loader.load(url, gltf => {
        const model = gltf.scene;
        model.scale.set(0.7,0.7,0.7);
        model.position.set(0,0,-1.3);
        scene.add(model);
        if(onLoad) onLoad(model);
      });
    }

    // --- 3D Rewards Bar ---
    function create3DRewardsBar() {
      // 1. Make a flat panel with emojis and text as 3D text or textures
      // Here we use simple colored boxes with emoji labels
      const group = new THREE.Group();
      REWARDS.forEach((r,i)=>{
        // Coin icon
        const geom = new THREE.CylinderGeometry(0.08,0.08,0.028,24);
        const mat = new THREE.MeshStandardMaterial({color:r.color,metalness:0.8,roughness:0.34});
        const coin = new THREE.Mesh(geom, mat);
        coin.position.set(i*0.22-0.11,0.1,-0.98); // space out
        group.add(coin);
        // Emoji label (sprite)
        const canvas = document.createElement('canvas');
        canvas.width = 80; canvas.height = 80;
        const ctx = canvas.getContext('2d');
        ctx.font = '48px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(r.emoji, 40, 40);
        ctx.font = 'bold 27px sans-serif';
        ctx.fillStyle = '#ffd700';
        ctx.fillText(r.count, 65, 65);
        const tex = new THREE.CanvasTexture(canvas);
        const spriteMat = new THREE.SpriteMaterial({map:tex});
        const sprite = new THREE.Sprite(spriteMat);
        sprite.position.set(i*0.22-0.11,0.21,-0.98);
        sprite.scale.set(0.15,0.15,0.15);
        group.add(sprite);
        r._sprite = sprite;
      });
      rewardsBarMesh = group;
      scene.add(group);
    }

    // --- Coins in AR Scene ---
    function createCoins() {
      const places = [[-0.32,0.02,-0.95],[0.34,0.03,-1.11]];
      REWARDS.forEach((r,i)=>{
        const coin = new THREE.Mesh(
          new THREE.TorusGeometry(0.085, 0.03, 19, 32),
          new THREE.MeshStandardMaterial({color:r.color,metalness:0.81,roughness:0.21})
        );
        coin.position.set(...places[i]);
        coin.userData.rewardId = r.id;
        scene.add(coin);
        coinMeshes.push(coin);
      });
    }

    // --- AR Setup ---
    function setupXR() {
      renderer = new THREE.WebGLRenderer({antialias:true,alpha:true});
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.xr.enabled = true;
      document.body.appendChild(renderer.domElement);

      // Add light
      scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 1));
      const dir = new THREE.DirectionalLight(0xffffff, 0.7); dir.position.set(0,6,7); scene.add(dir);

      // Load NFT
      loadGLB("https://modelviewer.dev/shared-assets/models/Astronaut.glb");

      // 3D Rewards bar (above NFT)
      create3DRewardsBar();

      // Coins
      createCoins();

      // XR Button
      document.getElementById("xr-button").onclick = ()=>{
        renderer.xr.setReferenceSpaceType('local');
        navigator.xr.requestSession('immersive-ar',{requiredFeatures:['hit-test']}).then(onSessionStarted);
      };
    }

    function onSessionStarted(session) {
      renderer.xr.setSession(session);
      xrSessionActive = true;
      controller = renderer.xr.getController(0);
      scene.add(controller);

      // On tap: raycast for coins
      controller.addEventListener('selectstart', onSelect);

      animate();
      document.getElementById('xr-button').style.display='none';
    }

    // --- Coin Collect Logic ---
    function onSelect() {
      // Raycast from controller (touch point) in AR
      const tempMatrix = new THREE.Matrix4();
      tempMatrix.identity().extractRotation(controller.matrixWorld);
      const raycaster = new THREE.Raycaster();
      raycaster.ray.origin.setFromMatrixPosition(controller.matrixWorld);
      raycaster.ray.direction.set(0,0,-1).applyMatrix4(tempMatrix);
      coinMeshes.forEach((mesh,idx)=>{
        if(mesh.visible) {
          const intersects = raycaster.intersectObject(mesh);
          if(intersects.length>0) {
            mesh.visible = false;
            // Update rewards and redraw text
            REWARDS[idx].count++;
            // Redraw emoji+count sprite
            const sprite = REWARDS[idx]._sprite;
            const ctx = sprite.material.map.image.getContext('2d');
            ctx.clearRect(0,0,80,80);
            ctx.font = '48px serif';
            ctx.fillText(REWARDS[idx].emoji, 40, 40);
            ctx.font = 'bold 27px sans-serif';
            ctx.fillStyle = '#ffd700';
            ctx.fillText(REWARDS[idx].count, 65, 65);
            sprite.material.map.needsUpdate = true;
          }
        }
      });
    }

    // --- Animate ---
    function animate() {
      renderer.setAnimationLoop(()=>{
        renderer.render(scene, camera);
      });
    }

    // --- Bootstrap ---
    if('xr' in navigator) setupXR();
    else document.getElementById('xr-button').innerText = "WebXR not supported";
  </script>
