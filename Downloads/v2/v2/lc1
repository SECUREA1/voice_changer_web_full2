      white-space: pre-wrap; word-break: break-all; line-height: 1.5;
    }
    #meta-data-panel code {
      background: #222; color: #9fd; padding: 2px 4px; border-radius: 5px;
    }
  </style>
</head>
<body>
  <h2>Composite NFT Viewer<br>
    <span style="font-size:15px;color:#9fd;font-weight:normal;">
      (Upload your NFT metadata JSON file, or drag &amp; drop it below!)
    </span>
  </h2>
  <div id="uploader">Click or drag your <b>NFT JSON</b> here</div>
  <div class="draggable" id="dragNFT" style="display:none;">
    <div class="layered-nft-container" id="compositeNFT"></div>
  </div>
  <div id="meta-data-panel" style="display:none;"></div>
  <script>
    // Uploader logic
    const uploader = document.getElementById('uploader');
    const dragNFT = document.getElementById('dragNFT');
    const nftContainer = document.getElementById('compositeNFT');
    const metaPanel = document.getElementById('meta-data-panel');
    let lastMeta = null;

    uploader.onclick = () => {
      const fileInput = document.createElement('input');
      fileInput.type = 'file'; fileInput.accept = '.json,application/json';
      fileInput.onchange = e => handleFile(e.target.files[0]);
      fileInput.click();
    };
    uploader.ondragover = e => { e.preventDefault(); uploader.classList.add('dragover'); };
    uploader.ondragleave = e => { uploader.classList.remove('dragover'); };
    uploader.ondrop = e => {
      e.preventDefault(); uploader.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    };

    function handleFile(file) {
      if (!file.name.endsWith('.json')) return alert('Please upload a JSON file.');
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const meta = JSON.parse(e.target.result);
          lastMeta = meta;
          displayNFT(meta);
          displayMeta(meta);
        } catch (e) {
          alert('Invalid JSON.');
        }
      };
      reader.readAsText(file);
    }

    // Render NFT scene from layers
    function displayNFT(meta) {
      nftContainer.innerHTML = ''; // Clear old
      if (!meta.layers || !meta.layers.length) {
        nftContainer.innerHTML = "<div style='color:#eee;padding:30px;'>No layers found in this NFT.</div>";
        dragNFT.style.display = 'block';
        return;
      }
      let bgElem = '', modelElem = '', audioElem = '';
      // Find best background
      const bgLayer = meta.layers.find(l => l.type === "background");
      if (bgLayer) {
        if (bgLayer.media_type.startsWith("video")) {
          bgElem = `<video class="background-media" src="${ipfsToHttp(bgLayer.url)}" autoplay muted loop playsinline></video>`;
        } else if (bgLayer.media_type.startsWith("image")) {
          bgElem = `<img class="background-media" src="${ipfsToHttp(bgLayer.url)}" alt="NFT background"/>`;
        }
      }
      // Foreground 3D model
      const fgLayer = meta.layers.find(l => l.type === "foreground");
      if (fgLayer) {
        modelElem = `
          <div class="glb-moveable" id="glbMover">
            <model-viewer src="${ipfsToHttp(fgLayer.url)}" camera-controls auto-rotate
              background-color="rgba(0,0,0,0)" shadow-intensity="1" exposure="1.0"
              style="width:100%;height:100%;">
            </model-viewer>
          </div>`;
      }
      // Audio
      const audioLayer = meta.layers.find(l => l.type === "audio");
      if (audioLayer) {
        audioElem = `<div class="audio-control"><audio src="${ipfsToHttp(audioLayer.url)}" controls autoplay loop></audio></div>`;
      }
      nftContainer.innerHTML = bgElem + modelElem + audioElem;
      dragNFT.style.display = 'block';

      // Play video if present
      const vid = nftContainer.querySelector('video');
      if (vid) vid.play().catch(()=>{});
    }

    // Show metadata panel (with custom fields highlighted)
    function displayMeta(meta) {
      let html = `<b>Name:</b> ${meta.name || "N/A"}<br>
        <b>Description:</b> ${meta.description || "N/A"}<br>`;
      if (meta.nft_type) html += `<b>NFT Type:</b> <code>${meta.nft_type}</code><br>`;
      if (meta.media_type) html += `<b>Media Type:</b> <code>${meta.media_type}</code><br>`;
      if (meta.animation_url) html += `<b>Animation URL:</b> <code>${meta.animation_url}</code><br>`;
      if (meta.controls) html += `<b>Controls:</b> <pre style="background:#1c1d2b;padding:8px 12px;border-radius:7px;color:#bff;">${JSON.stringify(meta.controls, null, 2)}</pre>`;
      if (meta.layers) html += `<b>Layers:</b> <pre style="background:#1c1d2b;padding:8px 12px;border-radius:7px;color:#f9d;">${JSON.stringify(meta.layers, null, 2)}</pre>`;
      metaPanel.innerHTML = html;
      metaPanel.style.display = 'block';
    }

    // IPFS url fix
    function ipfsToHttp(url) {
      if (!url) return '';
      if (url.startsWith('ipfs://')) return 'https://w3s.link/ipfs/' + url.replace('ipfs://','').replace(/^\/+/,'');
      return url;
    }

    // Make NFT scene draggable
    (function() {
      const dragElem = dragNFT;
      let isDragging = false, offsetX = 0, offsetY = 0;
      dragElem.addEventListener('mousedown', function(e) {
        if (e.target.closest('.glb-moveable') || e.target.tagName === 'AUDIO') return;
        isDragging = true;
        offsetX = e.clientX - dragElem.offsetLeft;
        offsetY = e.clientY - dragElem.offsetTop;
        dragElem.style.cursor = 'grabbing';
      });
      document.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        let x = e.clientX - offsetX, y = e.clientY - offsetY;
        x = Math.max(0, Math.min(window.innerWidth - dragElem.offsetWidth, x));
        y = Math.max(0, Math.min(window.innerHeight - dragElem.offsetHeight, y));
        dragElem.style.left = x + 'px'; dragElem.style.top = y + 'px';
      });
      document.addEventListener('mouseup', function() {
        isDragging = false; dragElem.style.cursor = 'grab';
      });
    })();

    // Make GLB model draggable within scene
    (function() {
      let isMoving = false, startX = 0, startY = 0, startLeft = 0, startTop = 0;
      document.addEventListener('mousedown', function(e) {
        const mover = document.getElementById('glbMover');
        if (!mover || !e.target.closest('#glbMover')) return;
        isMoving = true;
        startX = e.clientX; startY = e.clientY;
        startLeft = parseInt(mover.style.left || mover.offsetLeft);
        startTop = parseInt(mover.style.top || mover.offsetTop);
        mover.style.cursor = 'grabbing';
        e.preventDefault();
      });
      document.addEventListener('mousemove', function(e) {
        if (!isMoving) return;
        const mover = document.getElementById('glbMover');
        let dx = e.clientX - startX, dy = e.clientY - startY;
        let newLeft = startLeft + dx, newTop = startTop + dy;
        const parent = mover.parentElement;
        newLeft = Math.max(0, Math.min(parent.offsetWidth - mover.offsetWidth, newLeft));
        newTop = Math.max(0, Math.min(parent.offsetHeight - mover.offsetHeight, newTop));
        mover.style.left = newLeft + 'px'; mover.style.top = newTop + 'px';
      });
      document.addEventListener('mouseup', function() {
        isMoving = false;
        const mover = document.getElementById('glbMover');
        if (mover) mover.style.cursor = 'grab';
      });
    })();

    // Auto-load a sample NFT (remove/comment out this block to disable)
    window.addEventListener('DOMContentLoaded', () => {
      // SAMPLE NFT for demo
      const sample = {
        "name": "Sample Farm Horse Control NFT",
        "description": "A demo composite NFT: farm video, moveable horse GLB, horse audio, and custom controls.",
        "nft_type": "controlnft",
        "media_type": "application/x-controlnft+html",
        "animation_url": "ipfs://sample-html",
        "controls": {
          "version": "1.0",
          "supported_inputs": ["mouse", "touch"],
          "moveable_layers": ["3DModel"],
          "draggable_scene": true
        },
        "layers": [
          {
            "type": "background",
            "media_type": "video/mp4",
            "url": "https://player.vimeo.com/external/390280968.sd.mp4?s=ec3f1d2ce7e67d73d8572fd973a3abdbfd2255a7&profile_id=164&oauth2_token_id=57447761"
          },
          {
            "type": "foreground",
            "media_type": "model/gltf-binary",
            "url": "https://cdn.jsdelivr.net/gh/Sketchfab/experiments/model-viewer-examples@main/assets/models/Horse.glb"
          },
