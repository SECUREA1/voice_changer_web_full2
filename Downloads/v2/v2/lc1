  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
  <style>
    :root {
      --gold: #ffd700;
      --deep-gold: #ffef99;
      --red: #b30000;
      --dark: #18192d;
      --dark2: #221112;
      --border-radius: 20px;
    }
    body {
      background: linear-gradient(120deg, #18192d 80%, #420000 100%);
      color: var(--gold);
      font-family: 'Segoe UI', SegoeUI, Arial, sans-serif;
      margin: 0;
      min-height: 100vh;
    }
    .header-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 24px 38px 8px 38px;
      background: rgba(32,0,0,0.16);
      border-radius: 0 0 32px 32px;
      box-shadow: 0 7px 44px #b3000045;
    }
    .header-row h1 {
      color: var(--gold);
      font-size: 2.2em;
      font-weight: 900;
      text-shadow: 0 2px 18px #b3000050, 0 0 32px #ffd70045;
      letter-spacing: 0.01em;
      margin: 0;
    }
    .wallet-btn {
      background: var(--red); color: var(--gold);
      border: 2px solid #ffd700a8;
      border-radius: 9px;
      font-size: 1.13em; font-weight: bold; padding: 7px 20px; cursor: pointer;
      margin-left: 15px; transition: background 0.13s, color 0.13s, box-shadow .17s;
      box-shadow: 0 1px 13px #ffd7003b;
    }
    .wallet-btn:hover, .wallet-btn:focus {
      background: var(--gold); color: var(--red);
      box-shadow: 0 0 30px #ffd700c1;
    }
    #walletAddr { color: var(--deep-gold); text-shadow: 0 1px 6px #b3000031;}
    /* -------- REWARDS BAR --------- */
    .rewards-bar {
      margin: 0 auto 1.8em auto;
      display: flex; flex-wrap: nowrap;
      overflow-x: auto; gap: 0.85em;
      justify-content: center; align-items: flex-end;
      max-width: 100vw;
      background: linear-gradient(90deg,#2b0000 84%, #ffd70013 100%);
      border-radius: 18px;
      box-shadow: 0 2px 22px #ffd70021, 0 0 40px #b3000011;
      border: 2.1px solid #ffd700cc;
      padding: 0.62em 0.8em 0.38em 0.8em;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    .rewards-bar::-webkit-scrollbar {display: none;}
    .reward-chip {
      display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
      min-width: 54px; max-width: 90px; margin: 0 0.04em;
      padding: 0.13em 0.12em 0.26em 0.13em;
      background: none; border: none;
      font-size: 1em; cursor:pointer;
      position:relative; border-radius: 13px;
      box-shadow:0 2px 14px #ffd70017;
      transition: transform .14s, box-shadow .14s;
      border: 1.5px solid transparent;
    }
    .reward-chip:hover, .reward-chip:focus {
      transform: scale(1.10);
      box-shadow: 0 4px 36px #ffd700e0, 0 2px 12px #b3000050;
      z-index:2;
      border-color: var(--gold);
    }
    .reward-chip.rare .emoji { color:#e61cb2; text-shadow: 0 0 7px #ffd70080;}
    .reward-chip.unique .emoji { color:#1bb8e7; text-shadow: 0 0 7px #ffd70080;}
    .reward-chip.zorg .emoji { color:#ff7800; text-shadow: 0 0 7px #ffd70080;}
    .reward-chip .emoji {
      font-size: 1.55em; margin-bottom: 0.02em;
      filter: drop-shadow(0 0 8px #ffd70063);
      animation: pulseGlow 1.5s infinite alternate;
      text-shadow: 0 0 12px #ffd700a8;
    }
    .reward-chip .label {
      font-size: 1em; font-weight: 700; color: #ffd700;
      margin: 0.09em 0 0.11em 0; white-space: nowrap; text-align:center;
      text-shadow: 0 1px 7px #b3000032;
    }
    .reward-chip .supply-box {
      background: linear-gradient(90deg, #fffbe6 60%, #ffd700 100%);
      color: #b30000; border-radius: 9px;
      box-shadow: 0 2px 12px #ffd70060, 0 0 8px #b3000023;
      font-weight: bold; padding: 0.21em 0.92em 0.17em 0.92em;
      font-size: 1.05em; margin-top: 0.05em; min-width: 34px; text-align: center;
      border:2px solid #ffd70099; animation: supplyGlow 2.2s infinite alternate;
    }
    @keyframes pulseGlow {from { filter: drop-shadow(0 0 8px #ffd70090);}to { filter: drop-shadow(0 0 20px #ffd700ef);}}
    @keyframes supplyGlow {from { box-shadow: 0 2px 12px #ffd70041;}to { box-shadow: 0 0 20px #ffd700ee, 0 2px 12px #ffd70030;}}
    /* -------- GALLERY --------- */
    .gallery-list {
      display: flex; flex-wrap: wrap; gap: 34px; margin: 24px 38px 10px 38px;
      justify-content: flex-start;
    }
    .nft-card {
      background: linear-gradient(120deg, #231318 84%, #ffd70013 100%);
      border-radius: 18px;
      box-shadow: 0 4px 28px #b3000025, 0 6px 34px #ffd70020;
      padding: 15px 15px 14px 15px;
      width: 258px;
      cursor: pointer;
      transition: transform 0.14s, box-shadow 0.13s;
      display: flex; flex-direction: column; align-items: center;
      border: 2.3px solid #ffd700ea; position:relative; overflow:hidden;
    }
    .nft-card:hover { transform: scale(1.055); box-shadow: 0 8px 36px #ffd700f0, 0 2px 26px #b3000077; z-index:2;}
    .nft-thumb {width: 224px; height: 126px; object-fit: cover; border-radius: 13px; background: #320000; margin-bottom: 10px;}
    .nft-title { font-size: 18px; font-weight: bold; color: #ffd700; margin-bottom:1px; letter-spacing:0.01em;}
    .nft-desc { font-size: 13px; color: #eec; margin-top: 3px; margin-bottom: 8px; }
    .nft-meta-row {display:flex;gap:7px;justify-content:center;align-items:center;margin-bottom:2px;}
    .nft-reward-badge {
      display:flex;align-items:center;gap:3px;
      padding:2px 10px 2px 7px;border-radius:11px;
      background:#ffd70026;color:#b30000;font-size:1em;font-weight:700;margin-right:5px;
      border:1.6px solid #ffd700b6; box-shadow:0 0 6px #ffd7002b;
    }
    .nft-supply { font-size:13px; color:#ffd700;font-weight:700;}
    .nft-price { font-size:14px; color:#ffad49;font-weight:700; margin-left:7px;}
    .nft-action-btns {
      display: flex; gap: 0.55em; justify-content: center; margin-top: 0.55em;
    }
    .ar-view-btn, .mint-btn {
      padding: 7px 18px; font-size: 15px; font-weight: bold; border-radius: 9px;
      border: none; cursor: pointer; box-shadow: 0 1px 7px #ffd70035;
      transition: background 0.12s, color 0.12s;
      background: var(--gold); color: #b30000;
    }
    .ar-view-btn:hover, .mint-btn:hover { background: #b30000; color: #ffd700; }
    /* -------- MINT SECTION --------- */
    .mint-section {
      background: linear-gradient(120deg,#1e181e 85%, #ffd70013 100%);
      border-radius: 22px; border: 2.4px solid #ffd700e7;
      box-shadow: 0 6px 44px #ffd70022, 0 2px 14px #b300001a;
      max-width: 670px; margin: 38px auto 38px auto;
      padding: 34px 38px 28px 38px;
    }
    .mint-section h2 { margin-top: 0; color: var(--gold); text-shadow: 0 1px 14px #ffd70095;}
    .mint-form-row { margin-bottom: 18px; }
    .mint-form-row label { display: block; margin-bottom: 5px; font-size: 16px;}
    .mint-form-row input, .mint-form-row select {
      width: 100%; font-size: 16px; border-radius: 7px; border: 1.3px solid #ffd700a0;
      padding: 8px 12px;background: #18192d; color: #ffd700; margin-bottom: 3px;
      box-shadow: 0 1px 8px #ffd7001a;
    }
    #mintLivePreview {width: 100%; height: 340px; margin: 0 auto 22px auto;
      border-radius: 13px; overflow: hidden; box-shadow: 0 2px 18px #ffd7003b;background: #18192d;}
    #mint-confirm-btn {margin-top: 10px; padding: 10px 30px; font-size: 17px; font-weight: bold;border-radius: 10px; background: #b30000; color: #ffd700; border: 2px solid #ffd700a9; cursor: pointer; box-shadow: 0 1px 11px #ffd70016;}
    #mint-confirm-btn[disabled] { background: #383; color: #ffd70070; cursor: not-allowed; border-color:#ffd70060;}
    .mint-status { margin: 1em 0 0 0; color: #ffd700; min-height: 1.6em; }
    /* -------- MODAL --------- */
    #modalBG { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(40,10,10,0.92); z-index: 100; display: none; }
    #nftModal {position: fixed; left: 50%; top: 54%; transform: translate(-50%,-50%);width: 580px; background: #290000; border-radius: 22px; padding: 30px 28px 20px 28px;z-index: 101; display: none; box-shadow: 0 8px 52px #ffd70091;}
    .modal-close { position: absolute; right: 20px; top: 13px; color: #ffd700; font-size: 32px; cursor: pointer; z-index: 2; }
    .nft-modal-title { font-size: 23px; font-weight: bold; color: #ffd700; margin-bottom: 4px;}
    .nft-modal-desc { color: #ffd700b6; font-size: 15px; margin-bottom: 8px;}
    #model-viewer-wrap { width: 500px; height: 340px; margin: 0 auto 10px auto; border-radius: 13px; overflow: hidden; }
    .modal-action-row { display: flex; gap: 1em; justify-content: center; margin-top: 14px; }
    .modal-ar-btn, .modal-mint-btn {
      padding: 10px 30px; font-size: 17px; font-weight: bold; border-radius: 10px; border: none;
      background: #ffd700; color: #b30000; box-shadow: 0 1px 10px #ffd70040; cursor: pointer;
      transition: background 0.12s, color 0.12s;
    }
    .modal-ar-btn:hover, .modal-mint-btn:hover { background: #b30000; color: #ffd700; }
    /* -------- DAPPS --------- */
    .dapp-list {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1.13em; margin: 2em 38px 0.7em 38px; padding: 0;
    }
    .dapp-card {
      background: linear-gradient(120deg, #2a0000 80%, #ffd7000b 100%);
      border: 2.1px solid var(--gold);
      padding: 1.13em 1em; border-radius: 14px;
      box-shadow: 0 2px 12px #ffd70014; text-align: center;
      transition: box-shadow .13s, transform .14s;
      cursor:pointer;
    }
    .dapp-card:hover, .dapp-card:focus { box-shadow:0 3px 18px #ffd700b6, 0 1px 10px #b3000058; z-index:2; transform:scale(1.045);}
    .dapp-card b { color: var(--gold); font-size:1.13em;}
    .dapp-card .icon { font-size: 1.7em; margin-bottom:5px; display:block;}
    .dapp-card div { color:#ffe066; font-size:0.99em; margin:7px 0 11px 0;}
    .dapp-card a { display:inline-block; padding:7px 22px; margin-top:6px; background:var(--gold); color:var(--red); font-weight:700; border-radius:7px; text-decoration:none; border:1.5px solid var(--red);}
    .dapp-card a:hover { background:#fffbe6; color:#b30000;}
    footer {text-align:center; margin:2.2em 0 0.2em 0; color:#ffd700c9; font-size:1em; letter-spacing:0.03em;}
    @media (max-width: 750px) {
      .gallery-list {margin-left: 6px;}
      .mint-section, #nftModal, #model-viewer-wrap { width: 97vw !important; }
      #model-viewer-wrap, #mintLivePreview { height: 260px !important; }
      .dapp-list {margin-left:8px;margin-right:8px;}
    }
    @media (max-width: 490px) {
      .reward-chip { min-width:34px; max-width:54px; font-size:0.89em;}
      .nft-card {min-width:160px;width:98vw;}
      .mint-section{padding:10px;}
    }
  </style>
</head>
<body>
  <div class="header-row">
    <h1>🪐 Space NFT Marketplace</h1>
    <button class="wallet-btn" id="walletConnectBtn">Connect Wallet</button>
    <span id="walletAddr" style="margin-left:16px; font-weight:bold; font-size:1em;"></span>
  </div>
  <div class="rewards-bar" id="rewards-bar"></div>
  <div class="gallery-list" id="galleryList"></div>

  <!-- MINT FORM SECTION -->
  <div class="mint-section">
    <h2>Mint Your Space Artifact NFT</h2>
    <div id="mintLivePreview"></div>
    <form id="mint-form" autocomplete="off">
      <div class="mint-form-row">
        <label for="mintTitle">NFT Title:</label>
        <input id="mintTitle" placeholder="e.g. Alien Relic" required>
      </div>
      <div class="mint-form-row">
        <label for="mintQty">Quantity:</label>
        <input id="mintQty" type="number" min="1" max="25" value="1" required>
      </div>
      <div class="mint-form-row">
        <label for="mintChain">Chain:</label>
        <select id="mintChain" required>
          <option value="ethereum">Ethereum</option>
          <option value="solana">Solana</option>
          <option value="bsc">BNB Chain</option>
          <option value="cardano">Cardano</option>
        </select>
      </div>
      <div class="mint-form-row">
        <label for="mintWallet">Wallet Address:</label>
        <input id="mintWallet" placeholder="Paste destination wallet..." required>
      </div>
      <div class="mint-form-row">
        <label>3D Model (.glb/.gltf):</label>
        <input type="file" id="mintGLB" accept=".glb,.gltf">
      </div>
      <div class="mint-form-row">
        <label>Background Video:</label>
        <input type="file" id="mintVideo" accept="video/*">
      </div>
      <div class="mint-form-row">
        <label>Audio:</label>
        <input type="file" id="mintAudio" accept="audio/*">
      </div>
      <div class="mint-form-row">
        <label>Thumbnail Image:</label>
        <input type="file" id="mintImage" accept="image/*">
      </div>
      <button type="submit" id="mint-confirm-btn" disabled>Mint NFT</button>
      <div class="mint-status" id="mintStatus"></div>
    </form>
  </div>

  <!-- MODAL FOR NFT GALLERY PREVIEW -->
  <div id="modalBG"></div>
  <div id="nftModal">
    <span class="modal-close" id="modalClose">&times;</span>
    <div class="nft-modal-title" id="modalTitle"></div>
    <div class="nft-modal-desc" id="modalDesc"></div>
    <div id="model-viewer-wrap"></div>
    <div class="modal-action-row">
      <button class="modal-ar-btn" id="modalArBtn" style="display:none;">AR Viewer</button>
      <button class="modal-mint-btn" id="modalMintBtn">Mint This NFT</button>
    </div>
  </div>

  <!-- Dapp Footer / Launcher -->
  <div class="dapp-list">
    <div class="dapp-card"><span class="icon">🚀</span><b>Rocket Labs</b><div>Design and launch custom digital spacecraft NFTs.</div><a href="#">Explore</a></div>
    <div class="dapp-card"><span class="icon">🌌</span><b>Starmap Explorer</b><div>Discover, trade, and view cosmic NFT artifacts by quadrant.</div><a href="#">Navigate</a></div>
    <div class="dapp-card"><span class="icon">👽</span><b>Alien Signals</b><div>Collect and remix decoded space audio signals as NFTs.</div><a href="#">Analyze</a></div>
    <div class="dapp-card"><span class="icon">🛰️</span><b>Probe Factory</b><div>Assemble probes, earn badges for space missions, and win rewards.</div><a href="#">Launch</a></div>
    <div class="dapp-card"><span class="icon">🪐</span><b>Artifact Analytics</b><div>Visualize marketplace data across all star systems.</div><a href="#">Charts</a></div>
    <div class="dapp-card"><span class="icon">🌠</span><b>Galactic Pass</b><div>Manage access to exclusive missions, events, and drops.</div><a href="#">Access</a></div>
  </div>
  <footer>
    © 2025 ChainES Labs — Space Artifacts Edition
  </footer>
  <script type="module">
    // --- Rewards Bar ---
    const REWARDS = [
      {id:'alien',      emoji:'👽', label:"Alien Relic", live:3,    class:'rare'},
      {id:'moonrock',   emoji:'🪨', label:"Moon Rock",   live:12,   class:'unique'},
      {id:'probe',      emoji:'🛰️', label:"Lost Probe",  live:4,    class:'zorg'},
      {id:'starcrystal',emoji:'💎', label:"Star Crystal",live:9},
      {id:'starmap',    emoji:'🗺️', label:"Star Map",    live:5},
      {id:'fuelcell',   emoji:'⚡', label:"Fuel Cell",    live:18},
      {id:'helmet',     emoji:'👨‍🚀', label:"Space Helmet", live:8},
      {id:'comms',      emoji:'📡', label:"Comms Array",  live:6},
      {id:'artifact',   emoji:'🧬', label:"Ancient DNA",  live:2}
    ];
    function renderRewardsBar() {
      const bar = document.getElementById('rewards-bar');
      bar.innerHTML = REWARDS.map(r =>
        <div class="reward-chip${r.class ? ' '+r.class : ''}">
          <span class="emoji">${r.emoji}</span>
          <span class="label">${r.label}</span>
          <span class="supply-box">${r.live}</span>
        </div>
      ).join("");
    }
    renderRewardsBar();

    // --- Gallery Data ---
    let NFTs = [
      {
        name: "Alien Relic",
        description: "A mysterious artifact from a distant exoplanet. Scan in AR for secrets.",
        type: "Alien Relic",
        reward: "alien",
        supply: 3,
        price: "2.0 ETH",
        thumb: "https://modelviewer.dev/assets/poster-robot.png",
        glb: "https://modelviewer.dev/shared-assets/models/RobotExpressive.glb",
        video: "https://cdn.pixabay.com/video/2023/07/18/175955-844374889_large.mp4",
        audio: "https://cdn.pixabay.com/audio/2022/07/26/audio_12bfa1cd97.mp3"
      },
      {
        name: "Moon Rock",
        description: "Rare moon fragment, collected on Apollo XIII. AR-enabled.",
        type: "Moon Rock",
        reward: "moonrock",
        supply: 12,
        price: "1.1 ETH",
        thumb: "https://modelviewer.dev/assets/poster-helmet.png",
        glb: "https://modelviewer.dev/shared-assets/models/Helmet.glb",
        video: "https://www.w3schools.com/html/mov_bbb.mp4",
        audio: ""
      },
      {
        name: "Lost Probe",
        description: "Once lost, now rediscovered at the edge of the solar system.",
        type: "Lost Probe",
        reward: "probe",
        supply: 4,
        price: "3.2 ETH",
        thumb: "https://modelviewer.dev/assets/poster-astronaut.png",
        glb: "https://modelviewer.dev/shared-assets/models/Astronaut.glb",
        video: "https://www.w3schools.com/html/movie.mp4",
        audio: ""
      },
      {
        name: "Star Crystal",
        description: "Luminous crystal forged in a dying nebula.",
        type: "Star Crystal",
        reward: "starcrystal",
        supply: 9,
        price: "0.7 ETH",
        thumb: "https://modelviewer.dev/assets/poster-diamond.png",
        glb: "https://modelviewer.dev/shared-assets/models/Diamond.glb",
        video: "",
        audio: ""
      }
    ];

    // --- Reward Lookup ---
    const rewardMap = {};
    REWARDS.forEach(r => rewardMap[r.id] = r);

    // --- GALLERY RENDER ---
    const galleryDiv = document.getElementById('galleryList');
    function renderGallery() {
      galleryDiv.innerHTML = "";
      NFTs.forEach((nft, idx) => {
        const rwd = rewardMap[nft.reward] || {};
        const card = document.createElement('div');
        card.className = 'nft-card';
        card.innerHTML = 
          <img class="nft-thumb" src="${nft.thumb}" alt="NFT thumbnail">
          <div class="nft-title">${nft.name}</div>
          <div class="nft-desc">${nft.description}</div>
          <div class="nft-meta-row">
            <span class="nft-reward-badge">${rwd.emoji || "🪐"} ${rwd.label || nft.type}</span>
            <span class="nft-supply">Supply: ${nft.supply}</span>
            <span class="nft-price">${nft.price}</span>
          </div>
          <div class="nft-action-btns">
            ${nft.glb ? <button class="ar-view-btn" onclick="event.stopPropagation(); openNFTModal(${idx}, 'ar')">AR Viewer</button> : ''}
            <button class="mint-btn" onclick="event.stopPropagation(); openNFTModal(${idx}, 'mint')">Mint</button>
          </div>
        ;
        card.onclick = () => openNFTModal(idx, null);
        galleryDiv.appendChild(card);
      });
    }
    renderGallery();

    // ---- MODAL LOGIC ----
    window.openNFTModal = openNFTModal; // for use in onClick attribute
    const modalBG = document.getElementById('modalBG');
    const nftModal = document.getElementById('nftModal');
    const modalTitle = document.getElementById('modalTitle');
    const modalDesc = document.getElementById('modalDesc');
    const viewerWrap = document.getElementById('model-viewer-wrap');
    const modalArBtn = document.getElementById('modalArBtn');
    const modalMintBtn = document.getElementById('modalMintBtn');
    document.getElementById('modalClose').onclick = closeModal;
    modalBG.onclick = closeModal;

    function openNFTModal(idx, action) {
      const nft = NFTs[idx];
      modalTitle.textContent = nft.name;
      modalDesc.textContent = nft.description;
      viewerWrap.innerHTML = getNFTLiveSceneHTML({
        video: nft.video,
        glb: nft.glb,
        audio: nft.audio,
        image: nft.thumb
      });
      modalBG.style.display = 'block';
      nftModal.style.display = 'block';

      // AR Viewer Button only if glb exists
      if (nft.glb) {
        modalArBtn.style.display = "inline-block";
        modalArBtn.onclick = () => {
          // Directly trigger AR mode via model-viewer (on mobile will trigger AR).
          const temp = document.createElement("div");
          temp.innerHTML = <model-viewer src="${nft.glb}" ar ar-modes="scene-viewer quick-look webxr" style="display:none;"></model-viewer>;
          document.body.appendChild(temp);
          const modelViewer = temp.querySelector('model-viewer');
          // Model Viewer will automatically open AR prompt if on mobile.
          setTimeout(() => temp.remove(), 2500);
        };
      } else {
        modalArBtn.style.display = "none";
      }

      modalMintBtn.textContent = "Mint This NFT";
      modalMintBtn.onclick = () => {
        modalMintBtn.textContent = "Minting...";
        setTimeout(() => { modalMintBtn.textContent = "Mint This NFT"; alert("Mint simulated! Connect to wallet and backend for real minting."); }, 1400);
      };

      // Optionally auto-launch if user clicked AR or Mint
      if (action === "ar" && nft.glb) modalArBtn.click();
      if (action === "mint") modalMintBtn.click();
    }
    function closeModal() {
      nftModal.style.display = 'none';
      modalBG.style.display = 'none';
      viewerWrap.innerHTML = '';
    }

    // ---- MINT PREVIEW LOGIC ----
    function getNFTLiveSceneHTML({video, glb, audio, image}) {
      let bgElem = "";
      if (video) {
