        isMoving = true;
        startX = e.clientX; startY = e.clientY;
        startLeft = parseInt(mover.style.left || mover.offsetLeft);
        startTop = parseInt(mover.style.top || mover.offsetTop);
        mover.style.cursor = 'grabbing';
        e.preventDefault();
