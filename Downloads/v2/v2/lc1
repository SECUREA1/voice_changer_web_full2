    const audioUrl = "https://cdn.pixabay.com/audio/2022/07/26/audio_12bfa1cd97.mp3";

    // Layer storage for dynamic overlays
    let dynamicImages = [];

    function renderCompositeNFT() {
      const container = document.getElementById('compositeNFT');
      // Remove all but drop-zone
      [...container.children].forEach(child => {
        if (child.id !== "dropZone") child.remove();
      });

      // --- Add video background
      let bgElem = '';
      if (backgroundUrl.match(/\.(mp4|webm|ogg)$/i)) {
        bgElem = document.createElement('video');
        bgElem.className = "background-media";
        bgElem.src = backgroundUrl;
        bgElem.autoplay = true; bgElem.muted = true; bgElem.loop = true; bgElem.playsInline = true;
        container.appendChild(bgElem);
        bgElem.play().catch(()=>{});
      } else if (backgroundUrl.match(/\.(png|jpg|jpeg|gif)$/i)) {
        bgElem = document.createElement('img');
        bgElem.className = "background-media";
        bgElem.src = backgroundUrl;
        container.appendChild(bgElem);
      }

      // --- Add moveable images (from dynamicImages)
      dynamicImages.forEach(imgData => {
        const img = document.createElement('img');
        img.className = 'image-moveable';
        img.style.left = imgData.x + 'px';
        img.style.top = imgData.y + 'px';
        img.src = imgData.src;
        img.title = "Drag me!";
        img.width = 150;
        img.draggable = false;
        img.dataset.idx = imgData.idx;
        container.appendChild(img);
      });

      // --- Add the GLB model
      const glbDiv = document.createElement('div');
      glbDiv.className = 'glb-moveable';
      glbDiv.id = "glbMover";
