  </style>
</head>
<body>
  <div id="rewards-bar">🪙 Coins: <span id="rewards-bar-coin">0</span></div>
  <div id="howto">Drag the astronaut <b>over</b> the coin to collect it!</div>
  <div id="canvas-container"></div>
  <script src="https://cdn.jsdelivr.net/npm/three@0.151.3/build/three.min.js"></script>
