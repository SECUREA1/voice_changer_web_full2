          background-color="rgba(0,0,0,0)" shadow-intensity="1" exposure="1.0"
          style="width:100%;height:100%;">
        </model-viewer>
      `;
      container.appendChild(glbDiv);

      // --- Add audio controls
      if (audioUrl) {
        const audioDiv = document.createElement('div');
        audioDiv.className = "audio-control";
        audioDiv.innerHTML = `<audio src="${audioUrl}" controls autoplay loop></audio>`;
        container.appendChild(audioDiv);
      }
    }

    renderCompositeNFT();

    // --- NFT window draggable ---
    (function() {
      const dragElem = document.getElementById('dragNFT');
      let isDragging = false, offsetX = 0, offsetY = 0;
      dragElem.addEventListener('mousedown', function(e) {
        // Don't drag scene if clicking inside model, image, or audio
        if (
          e.target.closest('.glb-moveable') ||
          e.target.closest('.image-moveable') ||
          e.target.tagName === 'AUDIO'
        ) return;
        isDragging = true;
        offsetX = e.clientX - dragElem.offsetLeft;
        offsetY = e.clientY - dragElem.offsetTop;
        dragElem.style.cursor = 'grabbing';
      });
      document.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        let x = e.clientX - offsetX, y = e.clientY - offsetY;
        x = Math.max(0, Math.min(window.innerWidth - dragElem.offsetWidth, x));
        y = Math.max(0, Math.min(window.innerHeight - dragElem.offsetHeight, y));
        dragElem.style.left = x + 'px'; dragElem.style.top = y + 'px';
      });
      document.addEventListener('mouseup', function() {
        isDragging = false; dragElem.style.cursor = 'grab';
      });
    })();

    // --- GLB model draggable within scene ---
    (function() {
      let isMoving = false, startX = 0, startY = 0, startLeft = 0, startTop = 0;
      document.addEventListener('mousedown', function(e) {
        const mover = document.getElementById('glbMover');
        if (!mover || !e.target.closest('#glbMover')) return;
        isMoving = true;
        startX = e.clientX; startY = e.clientY;
        startLeft = parseInt(mover.style.left || mover.offsetLeft);
        startTop = parseInt(mover.style.top || mover.offsetTop);
        mover.style.cursor = 'grabbing';
        e.preventDefault();
      });
      document.addEventListener('mousemove', function(e) {
        if (!isMoving) return;
        const mover = document.getElementById('glbMover');
        let dx = e.clientX - startX, dy = e.clientY - startY;
        let newLeft = startLeft + dx, newTop = startTop + dy;
        const parent = mover.parentElement;
        newLeft = Math.max(0, Math.min(parent.offsetWidth - mover.offsetWidth, newLeft));
        newTop = Math.max(0, Math.min(parent.offsetHeight - mover.offsetHeight, newTop));
        mover.style.left = newLeft + 'px'; mover.style.top = newTop + 'px';
      });
      document.addEventListener('mouseup', function() {
        isMoving = false;
        const mover = document.getElementById('glbMover');
        if (mover) mover.style.cursor = 'grab';
      });
    })();

    // --- Each uploaded image draggable within scene ---
    (function() {
      let isImgMoving = false, imgIdx = -1, startX = 0, startY = 0, startLeft = 0, startTop = 0;
      document.addEventListener('mousedown', function(e) {
        const img = e.target.closest('.image-moveable');
        if (!img) return;
        isImgMoving = true;
        imgIdx = parseInt(img.dataset.idx);
        startX = e.clientX; startY = e.clientY;
        startLeft = parseInt(img.style.left || img.offsetLeft);
        startTop = parseInt(img.style.top || img.offsetTop);
        img.style.cursor = 'grabbing';
        e.preventDefault();
      });
      document.addEventListener('mousemove', function(e) {
        if (!isImgMoving || imgIdx < 0) return;
        let dx = e.clientX - startX, dy = e.clientY - startY;
        let imgData = dynamicImages[imgIdx];
        let newLeft = startLeft + dx, newTop = startTop + dy;
        // Boundaries
        const parent = document.getElementById('compositeNFT');
        newLeft = Math.max(0, Math.min(parent.offsetWidth - 150, newLeft));
        newTop = Math.max(0, Math.min(parent.offsetHeight - 80, newTop));
        imgData.x = newLeft; imgData.y = newTop;
        renderCompositeNFT();
      });
      document.addEventListener('mouseup', function() {
        isImgMoving = false; imgIdx = -1;
        document.querySelectorAll('.image-moveable').forEach(img => img.style.cursor = 'grab');
      });
    })();

    // --- Drag & drop image into scene ---
    (function() {
      const scene = document.getElementById('compositeNFT');
      const dropZone = document.getElementById('dropZone');
      let dragOver = false;
      // Only allow image drops
      scene.addEventListener('dragover', function(e) {
        e.preventDefault();
        if (!dragOver) { dropZone.classList.add('active'); dragOver = true; }
      });
      scene.addEventListener('dragleave', function(e) {
        dropZone.classList.remove('active'); dragOver = false;
      });
      scene.addEventListener('drop', function(e) {
        e.preventDefault(); dropZone.classList.remove('active'); dragOver = false;
        const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith("image/"));
        if (!files.length) return;
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function(evt) {
          // Place image at drop position, or default to (50,50)
          const rect = scene.getBoundingClientRect();
          const x = Math.max(0, Math.min(scene.offsetWidth-150, (e.clientX - rect.left) - 75));
          const y = Math.max(0, Math.min(scene.offsetHeight-80, (e.clientY - rect.top) - 40));
          dynamicImages.push({
            src: evt.target.result,
            x: x,
            y: y,
            idx: dynamicImages.length
          });
          renderCompositeNFT();
        };
        reader.readAsDataURL(file);
      });
    })();
  </script>
