from flask import Flask, request, jsonify
import requests

app = Flask(__name__)
WEB3_STORAGE_TOKEN = "YOUR_WEB3STORAGE_API_TOKEN"  # <-- Replace with your actual token

@app.route('/api/ipfs/upload', methods=['POST'])
def upload_to_ipfs():
    if 'file' not in request.files:
        return jsonify({'error': 'No file uploaded'}), 400
    file = request.files['file']
    files = {'file': (file.filename, file.stream, file.content_type)}
    headers = {'Authorization': f'Bearer {WEB3_STORAGE_TOKEN}'}
    response = requests.post("https://api.web3.storage/upload", files=files, headers=headers)
    if response.ok:
        cid = response.json()['cid']
        file_url = f"https://w3s.link/ipfs/{cid}/{file.filename}"
        return jsonify({'cid': cid, 'file_url': file_url, 'filename': file.filename})
    return jsonify({'error': 'IPFS upload failed', 'details': response.text}), 500

if __name__ == "__main__":
    app.run(debug=True)
