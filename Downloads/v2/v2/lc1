            "type": "audio",
            "media_type": "audio/mp3",
            "url": "https://cdn.pixabay.com/audio/2022/07/26/audio_12bfa1cd97.mp3"
          }
        ],
        "attributes": [
          { "trait_type": "Scene", "value": "Farm" },
          { "trait_type": "Animal", "value": "Horse" }
        ]
      };
      lastMeta = sample;
      displayNFT(sample);
      displayMeta(sample);
    });
  </script>
