      controls.enableDamping = true; controls.dampingFactor = 0.08;
      // Floor
      const floor = new THREE.Mesh(new THREE.PlaneGeometry(8,8), new THREE.MeshStandardMaterial({color:0x202233, roughness:0.97, metalness:0.02}));
      floor.rotation.x = -Math.PI/2; floor.position.y = -0.51; scene.add(floor);
      // NFT model
      let nftModel;
      const gltfLoader = new THREE.GLTFLoader();
      gltfLoader.load(nft.glb, gltf => {
        nftModel = gltf.scene;
        nftModel.scale.set(0.9,0.9,0.9);
        nftModel.position.set(0,0,0);
        scene.add(nftModel);
      });
      // Coin/Artifact
      let coinMesh;
